# Dynamically generated by Ansible (Jinja2). Don't edit manually

# Don't provide dhcp on the loopback interface:
except-interface=lo

{% for scope in dhcp_scopes %}
# {{ scope.name }} Scope:
dhcp-range=set:{{ scope.tag }},{{ scope.range_start }},{{ scope.range_end }},{{ scope.netmask }},24h
dhcp-option=tag:{{ scope.tag }},option:router,{{ scope.gateway }}

{% endfor %}
